{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lynx",
  "version": "0.1.1",
  "identifier": "dev.zdearo.lynx-ide",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lynx",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEQUI1NDFFQkEyNkNCOUIKUldTYnl5YTZIbFNyclJ5L0xVU1JDQ3B4Q2prYU9EWlRjRndkcUduSDV6dkFOTFJhdFlVWWRFVXgK",
      "endpoints": [
        "https://updates.zdearo.dev/api/update/{{target}}/{{arch}}/{{current_version}}?channel=stable"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
